#ifndef __STATEDRIVENENGINE_MQH__ #define __STATEDRIVENENGINE_MQH__ //+------------------------------------------------------------------+ //| StateDrivenEngine.mqh | //| | //| Portfolio Demonstration Module | //| Strategy-neutral state management architecture. | //| | //| This module demonstrates state transitions only. | //| It does not place or manage trades. | //+------------------------------------------------------------------+ //+------------------------------------------------------------------+ //| Engine states | //+------------------------------------------------------------------+ enum StateDrivenEngine_State { StateDrivenEngine_IDLE = 0, StateDrivenEngine_READY, StateDrivenEngine_ACTIVE, StateDrivenEngine_PAUSED, StateDrivenEngine_RESET }; //+------------------------------------------------------------------+ //| Runtime state | //+------------------------------------------------------------------+ StateDrivenEngine_State StateDrivenEngine_Current = StateDrivenEngine_IDLE; //+------------------------------------------------------------------+ //| Set engine state | //+------------------------------------------------------------------+ void StateDrivenEngine_SetState( const StateDrivenEngine_State state) { StateDrivenEngine_Current = state; } //+------------------------------------------------------------------+ //| Get current state | //+------------------------------------------------------------------+ StateDrivenEngine_State StateDrivenEngine_GetState() { return StateDrivenEngine_Current; } //+------------------------------------------------------------------+ //| Reset engine | //+------------------------------------------------------------------+ void StateDrivenEngine_Reset() { StateDrivenEngine_Current = StateDrivenEngine_IDLE; } //+------------------------------------------------------------------+ //| Check IDLE state | //+------------------------------------------------------------------+ bool StateDrivenEngine_IsIdle() { return ( StateDrivenEngine_Current == StateDrivenEngine_IDLE ); } //+------------------------------------------------------------------+ //| Check READY state | //+------------------------------------------------------------------+ bool StateDrivenEngine_IsReady() { return ( StateDrivenEngine_Current == StateDrivenEngine_READY ); } //+------------------------------------------------------------------+ //| Check ACTIVE state | //+------------------------------------------------------------------+ bool StateDrivenEngine_IsActive() { return ( StateDrivenEngine_Current == StateDrivenEngine_ACTIVE ); } //+------------------------------------------------------------------+ //| Check PAUSED state | //+------------------------------------------------------------------+ bool StateDrivenEngine_IsPaused() { return ( StateDrivenEngine_Current == StateDrivenEngine_PAUSED ); } //+------------------------------------------------------------------+ //| Check RESET state | //+------------------------------------------------------------------+ bool StateDrivenEngine_IsReset() { return ( StateDrivenEngine_Current == StateDrivenEngine_RESET ); } //+------------------------------------------------------------------+ //| Convert state to readable text | //+------------------------------------------------------------------+ string StateDrivenEngine_StateName( const StateDrivenEngine_State state) { switch(state) { case StateDrivenEngine_IDLE: return "IDLE"; case StateDrivenEngine_READY: return "READY"; case StateDrivenEngine_ACTIVE: return "ACTIVE"; case StateDrivenEngine_PAUSED: return "PAUSED"; case StateDrivenEngine_RESET: return "RESET"; } return "UNKNOWN"; } //+------------------------------------------------------------------+ #endif // __STATEDRIVENENGINE_MQH__
