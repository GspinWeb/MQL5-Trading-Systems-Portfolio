#ifndef __BUYSELLCNT_SIGNAL_MQH__ #define __BUYSELLCNT_SIGNAL_MQH__ //+------------------------------------------------------------------+ //| BUYSELLCnt_Signal.mqh | //| | //| Portfolio Demonstration Module | //| Reusable MQL5 position-counting component | //| | //| Monitoring only. | //| No order placement or position modification. | //+------------------------------------------------------------------+ //+------------------------------------------------------------------+ //| Count open BUY positions | //+------------------------------------------------------------------+ int BUYSELLCnt_BuyCount(const string symbol = "") { string target_symbol = symbol; if(target_symbol == "") target_symbol = _Symbol; int count = 0; const int total = PositionsTotal(); for(int i = 0; i < total; i++) { const ulong ticket = PositionGetTicket(i); if(ticket == 0) continue; if(!PositionSelectByTicket(ticket)) continue; if(PositionGetString(POSITION_SYMBOL) != target_symbol) continue; if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) != POSITION_TYPE_BUY) continue; count++; } return count; } //+------------------------------------------------------------------+ //| Count open SELL positions | //+------------------------------------------------------------------+ int BUYSELLCnt_SellCount(const string symbol = "") { string target_symbol = symbol; if(target_symbol == "") target_symbol = _Symbol; int count = 0; const int total = PositionsTotal(); for(int i = 0; i < total; i++) { const ulong ticket = PositionGetTicket(i); if(ticket == 0) continue; if(!PositionSelectByTicket(ticket)) continue; if(PositionGetString(POSITION_SYMBOL) != target_symbol) continue; if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) != POSITION_TYPE_SELL) continue; count++; } return count; } //+------------------------------------------------------------------+ //| Count all open positions | //+------------------------------------------------------------------+ int BUYSELLCnt_TotalCount(const string symbol = "") { return BUYSELLCnt_BuyCount(symbol) + BUYSELLCnt_SellCount(symbol); } //+------------------------------------------------------------------+ //| Determine whether BUY positions exist | //+------------------------------------------------------------------+ bool BUYSELLCnt_HasBuy(const string symbol = "") { return (BUYSELLCnt_BuyCount(symbol) > 0); } //+------------------------------------------------------------------+ //| Determine whether SELL positions exist | //+------------------------------------------------------------------+ bool BUYSELLCnt_HasSell(const string symbol = "") { return (BUYSELLCnt_SellCount(symbol) > 0); } //+------------------------------------------------------------------+ //| Determine whether any position exists | //+------------------------------------------------------------------+ bool BUYSELLCnt_HasPosition(const string symbol = "") { return (BUYSELLCnt_TotalCount(symbol) > 0); } //+------------------------------------------------------------------+ #endif // __BUYSELLCNT_SIGNAL_MQH__
