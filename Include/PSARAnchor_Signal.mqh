
#ifndef __PSARANCHOR_SIGNAL_MQH__ #define __PSARANCHOR_SIGNAL_MQH__ //+------------------------------------------------------------------+ //| PSARAnchor_Signal.mqh | //| | //| Portfolio Demonstration Module | //| H1 Parabolic SAR anchor-line signal engine | //| | //| This module provides reusable BUY/SELL signal logic only. | //| It does not place, modify, or close trades. | //+------------------------------------------------------------------+ //------------------------------------------------------------------- // Signal values //------------------------------------------------------------------- enum PSARAnchor_SignalType { PSARAnchor_SIGNAL_NONE = 0, PSARAnchor_SIGNAL_BUY = 1, PSARAnchor_SIGNAL_SELL = -1 }; //------------------------------------------------------------------- // Configuration //------------------------------------------------------------------- input double PSARAnchor_Step = 0.02; input double PSARAnchor_Maximum = 0.20; input ENUM_TIMEFRAMES PSARAnchor_Timeframe = PERIOD_H1; //------------------------------------------------------------------- // Runtime state //------------------------------------------------------------------- int PSARAnchor_Handle = INVALID_HANDLE; double PSARAnchor_ActivePrice = 0.0; bool PSARAnchor_Initialized = false; //+------------------------------------------------------------------+ //| Initialize PSARAnchor signal engine | //+------------------------------------------------------------------+ bool PSARAnchor_Init() { if(PSARAnchor_Handle != INVALID_HANDLE) IndicatorRelease(PSARAnchor_Handle); PSARAnchor_Handle = iSAR( _Symbol, PSARAnchor_Timeframe, PSARAnchor_Step, PSARAnchor_Maximum ); if(PSARAnchor_Handle == INVALID_HANDLE) return false; PSARAnchor_ActivePrice = 0.0; PSARAnchor_Initialized = true; return true; } //+------------------------------------------------------------------+ //| Release PSARAnchor signal engine | //+------------------------------------------------------------------+ void PSARAnchor_Deinit() { if(PSARAnchor_Handle != INVALID_HANDLE) { IndicatorRelease(PSARAnchor_Handle); PSARAnchor_Handle = INVALID_HANDLE; } PSARAnchor_ActivePrice = 0.0; PSARAnchor_Initialized = false; } //+------------------------------------------------------------------+ //| Set the active anchor price | //+------------------------------------------------------------------+ void PSARAnchor_SetAnchor(const double price) { if(price <= 0.0) return; PSARAnchor_ActivePrice = price; } //+------------------------------------------------------------------+ //| Return active anchor price | //+------------------------------------------------------------------+ double PSARAnchor_GetAnchor() { return PSARAnchor_ActivePrice; } //+------------------------------------------------------------------+ //| Return current price relationship to active anchor | //| | //| BUY = current Bid above anchor | //| SELL = current Bid below anchor | //| NONE = no active anchor | //+------------------------------------------------------------------+ PSARAnchor_SignalType PSARAnchor_GetSignal() { if(!PSARAnchor_Initialized) return PSARAnchor_SIGNAL_NONE; if(PSARAnchor_ActivePrice <= 0.0) return PSARAnchor_SIGNAL_NONE; const double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID); if(bid <= 0.0) return PSARAnchor_SIGNAL_NONE; if(bid > PSARAnchor_ActivePrice) return PSARAnchor_SIGNAL_BUY; if(bid < PSARAnchor_ActivePrice) return PSARAnchor_SIGNAL_SELL; return PSARAnchor_SIGNAL_NONE; } //+------------------------------------------------------------------+ //| Convenience BUY signal | //+------------------------------------------------------------------+ bool PSARAnchor_IsBuy() { return (PSARAnchor_GetSignal() == PSARAnchor_SIGNAL_BUY); } //+------------------------------------------------------------------+ //| Convenience SELL signal | //+------------------------------------------------------------------+ bool PSARAnchor_IsSell() { return (PSARAnchor_GetSignal() == PSARAnchor_SIGNAL_SELL); } //+------------------------------------------------------------------+ #endif // __PSARANCHOR_SIGNAL_MQH__
