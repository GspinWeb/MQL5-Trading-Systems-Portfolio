#ifndef __PSARANCHOR_SIGNAL_MQH__ #define __PSARANCHOR_SIGNAL_MQH__ //+------------------------------------------------------------------+ //| PSARAnchor_Signal.mqh | //| | //| Portfolio Demonstration Module | //| Reusable H1 Parabolic SAR anchor-line signal interface | //| | //| Signal only. | //| No order placement, modification, or position management. | //+------------------------------------------------------------------+ enum PSARAnchor_SignalType { PSARAnchor_SIGNAL_NONE = 0, PSARAnchor_SIGNAL_BUY = 1, PSARAnchor_SIGNAL_SELL = -1 }; //------------------------------------------------------------------- // Runtime state //------------------------------------------------------------------- int PSARAnchor_Handle = INVALID_HANDLE; double PSARAnchor_ActivePrice = 0.0; bool PSARAnchor_Initialized = false; //+------------------------------------------------------------------+ //| Initialize PSARAnchor engine | //+------------------------------------------------------------------+ bool PSARAnchor_Init(const ENUM_TIMEFRAMES timeframe = PERIOD_H1, const double step = 0.02, const double maximum = 0.20) { if(PSARAnchor_Handle != INVALID_HANDLE) IndicatorRelease(PSARAnchor_Handle); PSARAnchor_Handle = iSAR( _Symbol, timeframe, step, maximum ); if(PSARAnchor_Handle == INVALID_HANDLE) { PSARAnchor_Initialized = false; return false; } PSARAnchor_ActivePrice = 0.0; PSARAnchor_Initialized = true; return true; } //+------------------------------------------------------------------+ //| Release PSARAnchor engine | //+------------------------------------------------------------------+ void PSARAnchor_Deinit() { if(PSARAnchor_Handle != INVALID_HANDLE) { IndicatorRelease(PSARAnchor_Handle); PSARAnchor_Handle = INVALID_HANDLE; } PSARAnchor_ActivePrice = 0.0; PSARAnchor_Initialized = false; } //+------------------------------------------------------------------+ //| Assign active anchor price | //+------------------------------------------------------------------+ void PSARAnchor_SetAnchor(const double price) { if(price <= 0.0) return; PSARAnchor_ActivePrice = price; } //+------------------------------------------------------------------+ //| Get active anchor price | //+------------------------------------------------------------------+ double PSARAnchor_GetAnchor() { return PSARAnchor_ActivePrice; } //+------------------------------------------------------------------+ //| Get current signal | //| | //| Price > active anchor = BUY | //| Price < active anchor = SELL | //| No anchor / invalid price = NONE | //+------------------------------------------------------------------+ PSARAnchor_SignalType PSARAnchor_GetSignal() { if(!PSARAnchor_Initialized) return PSARAnchor_SIGNAL_NONE; if(PSARAnchor_ActivePrice <= 0.0) return PSARAnchor_SIGNAL_NONE; const double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID); if(bid <= 0.0) return PSARAnchor_SIGNAL_NONE; if(bid > PSARAnchor_ActivePrice) return PSARAnchor_SIGNAL_BUY; if(bid < PSARAnchor_ActivePrice) return PSARAnchor_SIGNAL_SELL; return PSARAnchor_SIGNAL_NONE; } //+------------------------------------------------------------------+ //| BUY signal | //+------------------------------------------------------------------+ bool PSARAnchor_IsBuy() { return (PSARAnchor_GetSignal() == PSARAnchor_SIGNAL_BUY); } //+------------------------------------------------------------------+ //| SELL signal | //+------------------------------------------------------------------+ bool PSARAnchor_IsSell() { return (PSARAnchor_GetSignal() == PSARAnchor_SIGNAL_SELL); } //+------------------------------------------------------------------+ //| Is engine initialized? | //+------------------------------------------------------------------+ bool PSARAnchor_IsInitialized() { return PSARAnchor_Initialized; } //+------------------------------------------------------------------+ #endif // __PSARANCHOR_SIGNAL_MQH__
