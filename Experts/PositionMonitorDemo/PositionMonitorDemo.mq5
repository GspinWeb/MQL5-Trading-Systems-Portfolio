//+------------------------------------------------------------------+ //| PositionMonitorDemo.mq5 | //| | //| MQL5 Trading Systems Portfolio | //| Demonstrates reusable BUY/SELL position monitoring. | //+------------------------------------------------------------------+ #property strict #property version "1.00" #property description "Portfolio demonstration EA for BUYSELLCnt signal module." #include "../../Include/BUYSELLCnt_Signal.mqh" //+------------------------------------------------------------------+ //| Expert initialization | //+------------------------------------------------------------------+ int OnInit() { Print("Position monitor demonstration initialized."); return INIT_SUCCEEDED; } //+------------------------------------------------------------------+ //| Expert deinitialization | //+------------------------------------------------------------------+ void OnDeinit(const int reason) { Comment(""); Print("Position monitor demonstration stopped."); } //+------------------------------------------------------------------+ //| Expert tick | //+------------------------------------------------------------------+ void OnTick() { const int buy_count = BUYSELLCnt_BuyCount(_Symbol); const int sell_count = BUYSELLCnt_SellCount(_Symbol); const int total_count = BUYSELLCnt_TotalCount(_Symbol); Comment( "BUY / SELL Position Monitor\n", "--------------------------------\n", "Symbol: ", _Symbol, "\n", "BUY positions: ", buy_count, "\n", "SELL positions: ", sell_count, "\n", "Total positions: ", total_count, "\n", "\n", "Monitoring only.\n", "No orders are placed." ); } //+------------------------------------------------------------------+
