//+------------------------------------------------------------------+ //| DemoEA.mq5 | //| | //| MQL5 Trading Systems Portfolio | //| Demonstrates consumption of a reusable signal module. | //+------------------------------------------------------------------+ #property strict #property version "1.00" #property description "Portfolio demonstration EA for PSARAnchor signal module." #include "../../Include/PSARAnchor_Signal.mqh" //------------------------------------------------------------------- // Demo configuration //------------------------------------------------------------------- input ENUM_TIMEFRAMES DemoEA_PSARTimeframe = PERIOD_H1; input double DemoEA_PSARStep = 0.02; input double DemoEA_PSARMaximum = 0.20; input double DemoEA_AnchorPrice = 0.0; //+------------------------------------------------------------------+ //| Expert initialization | //+------------------------------------------------------------------+ int OnInit() { if(!PSARAnchor_Init( DemoEA_PSARTimeframe, DemoEA_PSARStep, DemoEA_PSARMaximum)) { Print("PSARAnchor initialization failed."); return INIT_FAILED; } // Optional demonstration anchor. // In a production system the consuming EA would determine // the appropriate active anchor from its own strategy logic. if(DemoEA_AnchorPrice > 0.0) PSARAnchor_SetAnchor(DemoEA_AnchorPrice); Print("PSARAnchor demonstration initialized."); return INIT_SUCCEEDED; } //+------------------------------------------------------------------+ //| Expert deinitialization | //+------------------------------------------------------------------+ void OnDeinit(const int reason) { PSARAnchor_Deinit(); Comment(""); Print("PSARAnchor demonstration stopped."); } //+------------------------------------------------------------------+ //| Expert tick | //+------------------------------------------------------------------+ void OnTick() { const double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID); const double anchor = PSARAnchor_GetAnchor(); PSARAnchor_SignalType signal = PSARAnchor_GetSignal(); string signal_text = "NONE"; if(signal == PSARAnchor_SIGNAL_BUY) signal_text = "BUY"; if(signal == PSARAnchor_SIGNAL_SELL) signal_text = "SELL"; Comment( "PSARAnchor Signal Demonstration\n", "--------------------------------\n", "Symbol: ", _Symbol, "\n", "Bid: ", DoubleToString(bid,_Digits), "\n", "Active Anchor: ", DoubleToString(anchor,_Digits), "\n", "Signal: ", signal_text, "\n", "PSAR Timeframe: ", EnumToString(DemoEA_PSARTimeframe), "\n", "\n", "Signal-only demonstration.\n", "No orders are placed." ); // -------------------------------------------------------------- // Execution intentionally omitted. // // A consuming EA can use: // // PSARAnchor_IsBuy() // PSARAnchor_IsSell() // PSARAnchor_GetSignal() // // and implement its own execution/risk-management layer. // -------------------------------------------------------------- } //+------------------------------------------------------------------+
