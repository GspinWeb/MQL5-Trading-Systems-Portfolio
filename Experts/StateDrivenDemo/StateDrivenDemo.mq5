//+------------------------------------------------------------------+ //| StateDrivenDemo.mq5 | //| | //| MQL5 Trading Systems Portfolio | //| Demonstrates strategy-neutral state-driven EA architecture. | //+------------------------------------------------------------------+ #property strict #property version "1.00" #property description "Portfolio demonstration of a state-driven MQL5 engine." #include "../../Examples/StateDrivenEngine/StateDrivenEngine.mqh" //+------------------------------------------------------------------+ //| Demonstration settings | //+------------------------------------------------------------------+ input int StateDrivenDemo_ActiveSeconds = 30; //+------------------------------------------------------------------+ //| Runtime timing | //+------------------------------------------------------------------+ datetime StateDrivenDemo_StateStart = 0; //+------------------------------------------------------------------+ //| Expert initialization | //+------------------------------------------------------------------+ int OnInit() { StateDrivenEngine_SetState( StateDrivenEngine_READY ); StateDrivenDemo_StateStart = TimeCurrent(); Print("State-driven demonstration initialized."); return INIT_SUCCEEDED; } //+------------------------------------------------------------------+ //| Expert deinitialization | //+------------------------------------------------------------------+ void OnDeinit(const int reason) { StateDrivenEngine_Reset(); Comment(""); Print("State-driven demonstration stopped."); } //+------------------------------------------------------------------+ //| Expert tick | //+------------------------------------------------------------------+ void OnTick() { const datetime now = TimeCurrent(); const int elapsed = (int)(now - StateDrivenDemo_StateStart); StateDrivenEngine_State state = StateDrivenEngine_GetState(); // --------------------------------------------------------------- // Demonstration state progression // --------------------------------------------------------------- if(state == StateDrivenEngine_READY) { if(elapsed >= 5) { StateDrivenEngine_SetState( StateDrivenEngine_ACTIVE ); StateDrivenDemo_StateStart = now; } } else if(state == StateDrivenEngine_ACTIVE) { if(elapsed >= StateDrivenDemo_ActiveSeconds) { StateDrivenEngine_SetState( StateDrivenEngine_PAUSED ); StateDrivenDemo_StateStart = now; } } else if(state == StateDrivenEngine_PAUSED) { if(elapsed >= 10) { StateDrivenEngine_SetState( StateDrivenEngine_RESET ); StateDrivenDemo_StateStart = now; } } else if(state == StateDrivenEngine_RESET) { StateDrivenEngine_Reset(); StateDrivenEngine_SetState( StateDrivenEngine_READY ); StateDrivenDemo_StateStart = now; } state = StateDrivenEngine_GetState(); // --------------------------------------------------------------- // Display current engine state // --------------------------------------------------------------- Comment( "State-Driven Engine Demonstration\n", "--------------------------------\n", "Symbol: ", _Symbol, "\n", "Current State: ", StateDrivenEngine_StateName(state), "\n", "State Duration: ", (int)(now - StateDrivenDemo_StateStart), " sec\n", "\n", "Architecture demonstration only.\n", "No orders are placed." ); } //+------------------------------------------------------------------+
